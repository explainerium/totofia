/// Delivery zone, e.g. "Inside Dhaka" / "Outside Dhaka". A district belongs to at most one zone;
/// districts that are not listed anywhere use the zone marked `isDefault`.
model ShippingZone {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  fee               Decimal  @db.Decimal(12, 2)
  /// Delivery is free when the discounted subtotal reaches this amount.
  freeAboveSubtotal Decimal? @map("free_above_subtotal") @db.Decimal(12, 2)
  minDays           Int      @default(1) @map("min_days")
  maxDays           Int      @default(3) @map("max_days")
  /// District codes from src/lib/geo/bd.ts.
  districts         String[]
  isDefault         Boolean  @default(false) @map("is_default")
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  translations ShippingZoneTranslation[]

  @@map("shipping_zones")
}

model ShippingZoneTranslation {
  id     String @id @default(uuid()) @db.Uuid
  zoneId String @map("zone_id") @db.Uuid
  locale Locale
  name   String

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, locale])
  @@map("shipping_zone_translations")
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  imageId   String?  @map("image_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryTree")
  image        Asset?                @relation(fields: [imageId], references: [id], onDelete: SetNull)
  translations CategoryTranslation[]
  products     ProductCategory[]

  @@index([parentId])
  @@map("categories")
}

model CategoryTranslation {
  id              String  @id @default(uuid()) @db.Uuid
  categoryId      String  @map("category_id") @db.Uuid
  locale          Locale
  name            String
  slug            String
  description     String?
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

// ─── Attributes (Size, Color) ────────────────────────────────────────────────

model Attribute {
  id        String @id @default(uuid()) @db.Uuid
  /// Stable machine name used in filters, e.g. "size", "color".
  code      String @unique
  sortOrder Int    @default(0) @map("sort_order")

  translations AttributeTranslation[]
  values       AttributeValue[]

  @@map("attributes")
}

model AttributeTranslation {
  id          String @id @default(uuid()) @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid
  locale      Locale
  name        String

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, locale])
  @@map("attribute_translations")
}

model AttributeValue {
  id          String  @id @default(uuid()) @db.Uuid
  attributeId String  @map("attribute_id") @db.Uuid
  /// URL-safe value used in filters, e.g. "0-3m", "sage".
  code        String
  sortOrder   Int     @default(0) @map("sort_order")
  /// Swatch color for color attributes.
  colorHex    String? @map("color_hex")

  attribute    Attribute                   @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  translations AttributeValueTranslation[]
  variants     VariantAttributeValue[]

  @@unique([attributeId, code])
  @@map("attribute_values")
}

model AttributeValueTranslation {
  id      String @id @default(uuid()) @db.Uuid
  valueId String @map("value_id") @db.Uuid
  locale  Locale
  label   String

  value AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([valueId, locale])
  @@map("attribute_value_translations")
}

// ─── Products ────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductBadge {
  NEW
  ORGANIC
  BESTSELLER
}

model Product {
  id              String         @id @default(uuid()) @db.Uuid
  status          ProductStatus  @default(DRAFT)
  ageMinMonths    Int?           @map("age_min_months")
  ageMaxMonths    Int?           @map("age_max_months")
  isFeatured      Boolean        @default(false) @map("is_featured")
  badges          ProductBadge[]
  featuredImageId String?        @map("featured_image_id") @db.Uuid
  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  /// Denormalized from active variants by the product service (listing sort / filter).
  minPrice   Decimal? @map("min_price") @db.Decimal(12, 2)
  totalStock Int      @default(0) @map("total_stock")

  featuredImage Asset?               @relation("ProductFeaturedImage", fields: [featuredImageId], references: [id], onDelete: SetNull)
  translations  ProductTranslation[]
  categories    ProductCategory[]
  images        ProductImage[]
  variants      ProductVariant[]
  wishlistItems WishlistItem[]
  reviews       Review[]

  @@index([status, publishedAt])
  @@index([status, minPrice])
  @@map("products")
}

model ProductTranslation {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  locale           Locale
  name             String
  slug             String
  shortDescription String? @map("short_description")
  /// Sanitized HTML.
  description      String?
  materialCare     String? @map("material_care")
  metaTitle        String? @map("meta_title")
  metaDescription  String? @map("meta_description")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@map("product_translations")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  sortOrder  Int    @default(0) @map("sort_order")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  assetId   String  @map("asset_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")
  altBn     String? @map("alt_bn")
  altEn     String? @map("alt_en")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id                String    @id @default(uuid()) @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  sku               String    @unique
  price             Decimal   @db.Decimal(12, 2)
  salePrice         Decimal?  @map("sale_price") @db.Decimal(12, 2)
  saleStartsAt      DateTime? @map("sale_starts_at")
  saleEndsAt        DateTime? @map("sale_ends_at")
  stock             Int       @default(0)
  lowStockThreshold Int       @default(3) @map("low_stock_threshold")
  weightGrams       Int?      @map("weight_grams")
  imageId           String?   @map("image_id") @db.Uuid
  isActive          Boolean   @default(true) @map("is_active")
  isDefault         Boolean   @default(false) @map("is_default")
  sortOrder         Int       @default(0) @map("sort_order")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  image           Asset?                  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  attributeValues VariantAttributeValue[]
  cartItems       CartItem[]

  @@index([productId])
  @@map("product_variants")
}

model VariantAttributeValue {
  variantId        String @map("variant_id") @db.Uuid
  attributeValueId String @map("attribute_value_id") @db.Uuid

  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

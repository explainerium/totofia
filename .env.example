# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Pooled connection used by the app at runtime
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/totofia
# Direct connection used by `prisma migrate` (same as DATABASE_URL locally)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/totofia
# Only needed when the DB user cannot create databases (e.g. `npx prisma dev`)
SHADOW_DATABASE_URL=
# Connection pool size (default 10). Use 1 with `npx prisma dev`.
DATABASE_POOL_MAX=

# --- Auth (better-auth, Phase 3) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# First admin account, created/promoted by `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Encryption key for secrets stored in DB (payment gateway credentials), 32+ chars ---
# Changing it makes saved gateway credentials unreadable (re-enter them in the admin).
CREDENTIALS_KEY=

# --- Storage: local | r2 (Phase 1) ---
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_MEDIA_URL=

# --- Mail (Phase 2) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Totofia <no-reply@totofia.com>"
# New-order notifications for staff
ADMIN_NOTIFY_EMAIL=

# --- Online payment ---
# SSLCommerz / aamarPay credentials, sandbox/live mode and on/off are set in
# Admin → Settings → Payments (stored encrypted with CREDENTIALS_KEY).
# Development only: point the gateways at the local mocks in tests/mocks.
SSLCZ_BASE_URL=
AAMARPAY_BASE_URL=

# --- Rate limits shared across instances (optional, recommended on Vercel) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron ---
CRON_SECRET=

# --- Analytics ---
# GA4 / Meta Pixel ids are set in Admin → Settings. Optional server-side purchase events:
META_CAPI_ACCESS_TOKEN=

LOG_LEVEL=info
